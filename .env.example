# Owed — local / production configuration
# Never commit .env or paste secrets into chat.

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="owed_session"
SESSION_DAYS="30"
CRON_SECRET="change-me-before-production"
SEND_MODE="simulate" # simulate | live
QUIET_HOURS_START="21"
QUIET_HOURS_END="7"

# Technical safety limits (not customer-facing plan quotas)
MAX_INVOICES_PER_IMPORT="1000"
REMINDER_RUN_SCAN_LIMIT="5000"
REMINDER_RUN_SEND_LIMIT="250"
REMINDER_RUN_PER_USER_LIMIT="100"

# Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VALIDATE_SIGNATURE="true"

# Resend email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="reminders@yourdomain.com"
# Best: use a Resend inbound domain and include {invoiceId} for reply correlation.
# Example: reply+{invoiceId}@inbound.yourdomain.com
RESEND_REPLY_TO_EMAIL=""
RESEND_WEBHOOK_SECRET=""

# OpenAI drafting (optional; deterministic templates work without it)
OPENAI_API_KEY=""
OPENAI_DRAFT_MODEL="gpt-5.6-luna"

# Stripe billing
STRIPE_SECRET_KEY="" # optional fallback when using API-created Checkout/Portal sessions
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PAYMENT_LINK_STARTER=""
STRIPE_PAYMENT_LINK_PRO=""
STRIPE_PORTAL_LOGIN_URL=""
STRIPE_PORTAL_CONFIGURATION_ID=""
